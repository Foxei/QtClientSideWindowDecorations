{
  "name": "QtClientSideWindowDecorations",
  "build": {
    "dockerfile": "../docker/linux/Dockerfile",
    "context": "../docker/linux",
    "target": "dev"
  },
  "remoteUser": "ubuntu",
  "containerEnv": {
    "CMAKE_GENERATOR": "Ninja"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "cmake.buildDirectory": "${workspaceFolder}/build/devcontainer",
        "cmake.configureOnOpen": true,
        "cmake.configureSettings": {
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        },
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/build/devcontainer",
          "--header-insertion=never"
        ],
        "C_Cpp.intelliSenseEngine": "disabled"
      }
    }
  },
  "postCreateCommand": "cmake -S . -B build/devcontainer -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
}
